# Host ports for the local dev gateway. The gateway always listens on 8088/8043
# inside the container; these only control what they're published as on your machine.
# House port map (see the repos' shared CLAUDE.md): ingots=9088, forge=9188,
# observability=9288 — this module takes the next free block, 9388/9343.
GATEWAY_HTTP_PORT=9388
GATEWAY_HTTPS_PORT=9343
