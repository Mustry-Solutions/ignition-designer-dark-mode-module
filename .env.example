# Host ports for the local dev gateway. The gateway always listens on Ignition's
# own 8088/8043 inside the container; these control only what they are published
# as on your machine, and they default to the same.
#
# Override them if you already run a gateway on 8088 — copy this file to `.env`
# (which is gitignored) and change the values. Nothing else needs to change; the
# ops scripts and the printed URLs follow whatever you set here.
GATEWAY_HTTP_PORT=8088
GATEWAY_HTTPS_PORT=8043
